# Local development settings. Copy to .env and fill in your own values (.env is git-ignored).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecommerce
DB_USER=ecommerce_app
DB_PASSWORD=choose-your-own-password

# AWS deployment: use a Secrets Manager secret (RDS-managed) instead of DB_USER/DB_PASSWORD
# DB_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:<account-id>:secret:<name>
# AWS_REGION=ap-south-1

# Optional
# CORS_ORIGINS=http://localhost:8000
# FLASK_DEBUG=1
