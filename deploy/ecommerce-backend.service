# App tier (Flask under gunicorn), managed by systemd.
# Install to /etc/systemd/system/ecommerce-backend.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now ecommerce-backend
[Unit]
Description=E-commerce Flask backend
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/ecommerce/backend
EnvironmentFile=/etc/ecommerce.env
ExecStart=/opt/ecommerce/venv/bin/gunicorn --workers 2 --bind 0.0.0.0:5000 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
